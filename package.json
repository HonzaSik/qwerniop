{
  "name": "tenfold",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "dependencies": {
    "svelte": "^5.57.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "svelte-check": "^4.7.7",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/stamp-sw.mjs && node scripts/size-check.mjs",
    "preview": "vite preview",
    "check": "biome check . && tsc --noEmit && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:bench": "vitest bench --run"
  }
}
